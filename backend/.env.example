# ============================================================
# SIH Satellite Intelligence - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ============================================================
# Database Configuration
# ============================================================
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/satellite_intelligence
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satellite_intelligence
DB_USER=postgres
DB_PASSWORD=your_password

# ============================================================
# Qdrant Configuration
# ============================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_STORAGE=qdrant_storage

# ============================================================
# Collection Names
# ============================================================
CLIP_COLLECTION=satellite_tiles_clip
CLAY_COLLECTION=satellite_tiles

# ============================================================
# Model Paths
# ============================================================
CLAY_MODEL_PATH=models/clay/v1.5/clay-v1.5.ckpt
CHANGEFORMER_MODEL_PATH=models/changeformer/Change Former checkpoints/best_ckpt.pt
CHANGEFORMER_REPO=changeformer-repo

# ============================================================
# Data Paths
# ============================================================
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
TILES_DIR=data/tiles
EMBEDDINGS_DIR=embeddings
CHANGE_RESULTS_DIR=data/change_results
TEMPORAL_PAIRS_DIR=data/temporal_pairs
CLUSTERS_DIR=data/clusters
EARLIEST_CHANGES_DIR=data/earliest_changes
EXPORTS_DIR=data/exports

# ============================================================
# Processing Configuration
# ============================================================
# Tile Configuration
TILE_SIZE=256
MIN_VALID_PERCENTAGE=60.0

# Change Detection Configuration
CHANGE_PERCENTAGE_THRESHOLD=5.0
CONFIDENCE_THRESHOLD=0.5
CLOUD_SHADOW_BUFFER=0

# Clustering Configuration
CLUSTER_MIN_SIZE=5
CLUSTER_MIN_SAMPLES=5

# Clay Embedding Configuration
CLAY_BATCH_SIZE=32
CLAY_DEVICE=cuda  # cuda or cpu

# ============================================================
# Background Worker Configuration
# ============================================================
WORKER_THREADS=4
WORKER_TIMEOUT=3600  # seconds
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=60  # seconds

# ============================================================
# API Configuration
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DEBUG=False

# ============================================================
# Phase Execution
# ============================================================
# Set to true to auto-run phases on startup
AUTO_RUN_PHASES=true
# Comma-separated list of phases to skip on startup
SKIP_PHASES=6,7  # Example: skip Phase 6 and 7
